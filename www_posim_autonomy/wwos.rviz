Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 16; 35; 48
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz_default_plugins/Odometry
      Name: BlueROV2 odometry
      Enabled: true
      Topic:
        Value: /model/bluerov2/odometry
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Keep: 30
      Shape: Axes
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 750
